generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String   @map("hashed_pwd")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  files     File[]
  folders   Folder[]
}

model Folder {
  id       String   @id @default(uuid()) @db.Uuid
  name     String
  ownerId  String   @map("owner_id") @db.Uuid
  parentId String?  @map("parent_id") @db.Uuid
  isRoot   Boolean  @default(false) @map("is_root")
  files    File[]
  owner    User     @relation(fields: [ownerId], references: [id])
  parent   Folder?  @relation("NestedFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("NestedFolder")

  @@unique([ownerId, isRoot], where: raw("(is_root = true)"))
  @@index([ownerId, isRoot], where: raw("(is_root = true)"))
}

model File {
  id       String  @id
  name     String
  suffix   String
  size     Decimal
  ownerId  String  @db.Uuid
  folderId String  @db.Uuid
  src      String
  mimetype String?
  folder   Folder  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  owner    User    @relation(fields: [ownerId], references: [id])
}
