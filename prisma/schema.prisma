generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String   @map("hashed_pwd")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  root      Folder?
}

model Folder {
  id       String   @id @default(uuid()) @db.Uuid
  name     String
  ownerId  String   @unique @map("owner_id") @db.Uuid
  parentId String?  @map("parent_id") @db.Uuid
  isRoot   Boolean  @default(false) @map("is_root")
  owner    User     @relation(fields: [ownerId], references: [id])
  parent   Folder?  @relation("NestedFolder", fields: [parentId], references: [id])
  children Folder[] @relation("NestedFolder")
}
