<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>File Uploader</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <% if (locals.user) { %>
    <h1>Welcome Back, <%= user.firstName %> <%= user.lastName %>!</h1>
    <%- include("partials/folderList", { folder: currFolder }) %>
    <%- include("partials/fileSubmitForm", { folder: currFolder }) %>
    <div class="navLinks">
      <a href="/">Back Home</a>
      <a href="/log-out">LOG OUT</a>
    </div>
  <% } else { %>
    <h1>Error: You were not authenticated</h1>
    <a href="/login">Back to Login</a>
  <% } %>

</body>
</html>
