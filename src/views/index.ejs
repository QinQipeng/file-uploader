<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Message Board</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <% if (locals.user) { %>
    <h1>Welcome Back, <%= user.firstName %> <%= user.lastName %>!</h1>
    <%- include("partials/folderList", { folder: currFolder}) %>
    <form action="/folder/<%= currFolder.id %>/new" method="post">
      <input type="text" name="newName" required>
      <button type="submit">+ Folder</button>
    </form>
    <form action="/file/<%= user.id %>" method="post" enctype="multipart/form-data">
      <input type="file" name="file" />
      <button type="submit">Submit File</button>
    </form>
    <a href="/log-out">LOG OUT</a>
  <% } else { %>
    <h1>Error: You were not authenticated</h1>
    <a href="/login">Back to Login</a>
  <% } %>

</body>
</html>
